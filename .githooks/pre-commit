#!/usr/bin/env sh
set -eu

if [ "${SERENITY_SKIP_STYLE_HOOK:-}" = "1" ]; then
  echo "Skipping Serenity style hook because SERENITY_SKIP_STYLE_HOOK=1"
  exit 0
fi

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$staged_files" ]; then
  exit 0
fi

echo "Running sbt -v scalafmtAll 'Compile / scalafix' 'Test / scalafix' before commit..."
if command -v cmd.exe >/dev/null 2>&1; then
  MSYS2_ARG_CONV_EXCL="*" cmd.exe /c sbt -v scalafmtAll "Compile / scalafix" "Test / scalafix"
else
  sbt -v scalafmtAll "Compile / scalafix" "Test / scalafix"
fi

printf '%s\n' "$staged_files" | while IFS= read -r path; do
  if [ -n "$path" ] && [ -e "$path" ]; then
    git add -- "$path"
  fi
done
